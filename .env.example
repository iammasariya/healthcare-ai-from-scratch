# Application Settings
APP_NAME=Healthcare AI Service
APP_VERSION=0.7.0
DEBUG=false

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=/var/log/healthcare-ai/app.log

# Security Settings (adjust for production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# Request Settings
MAX_NOTE_LENGTH=10000
REQUEST_TIMEOUT=30

# Privacy Settings
LOG_PAYLOAD_PREVIEW_LENGTH=100

# LLM Settings (Post 2)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here
LLM_ENABLED=true
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2

# Shadow Mode Settings (Post 6)
SHADOW_MODE_ENABLED=true
SHADOW_WRITE_RESULTS=true
SHADOW_RESULTS_DIR=shadow_results
SHADOW_SIMILARITY_THRESHOLD=0.35
SHADOW_ALERT_SIMILARITY_THRESHOLD=0.25
SHADOW_PROMOTION_MIN_REQUESTS=5
SHADOW_PROMOTION_MIN_AVG_SIMILARITY=0.55
SHADOW_PROMOTION_MAX_DIVERGENCE_RATE=0.20
SHADOW_CANDIDATE_MODEL=claude-3-5-sonnet-20241022
SHADOW_CANDIDATE_TEMPERATURE=0.2
# SHADOW_CANDIDATE_PROMPT_VERSION=1.1.0

# HAPI FHIR Settings (Post 6)
# Public demo server example: https://hapi.fhir.org/baseR4
# HAPI_FHIR_BASE_URL=https://hapi.fhir.org/baseR4
HAPI_FHIR_TIMEOUT_SECONDS=10

# Monitoring Settings (Post 7)
MONITORING_ENABLED=true
MONITORING_WINDOW_SIZE=20
MONITORING_MIN_RUNS_FOR_ACTIONS=5
MONITORING_MAX_DIVERGENCE_RATE=0.30
MONITORING_MAX_CRITICAL_ALERT_RATE=0.10
MONITORING_MAX_AVG_SHADOW_LATENCY_MS=3000.0
MONITORING_MAX_AVG_SHADOW_COST_USD=0.02
MONITORING_ACTION_TTL_MINUTES=30
MONITORING_STATE_FILE=monitoring_state.json

# Prompt Management Settings (Post 3)
# Directory containing versioned prompt YAML files
PROMPTS_DIR=prompts
# Enable prompt integrity verification (recommended for production)
PROMPT_INTEGRITY_CHECK=true
